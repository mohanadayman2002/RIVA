# ---- Server ----
PORT=3000
# Public HTTPS URL of this server (ngrok URL in dev, your domain in prod).
# This is what gets embedded in the presentation link sent to the agent.
BASE_URL=https://your-subdomain.ngrok-free.app

# ---- WhatsApp Cloud API (Meta) ----
# System user / app access token from developers.facebook.com
WHATSAPP_TOKEN=
# The phone number ID (NOT the phone number itself) from WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose — paste the same value into Meta's webhook config
WHATSAPP_VERIFY_TOKEN=riva-verify
# App secret from App Settings > Basic. Enables webhook signature checks.
WHATSAPP_APP_SECRET=
GRAPH_VERSION=v22.0
# Only override for local testing against a stub Graph API
# GRAPH_BASE_URL=https://graph.facebook.com

# ---- Supabase (Settings → API in the dashboard) ----
# Leave empty to keep using the local JSON store + data/uploads folder.
SUPABASE_URL=
# service_role key — server only, bypasses RLS, never put this in a browser
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=listings

# ---- Branding shown on the presentation ----
BRAND_NAME=RIVA Properties
BRAND_TAGLINE=
BRAND_AGENT=
# Digits only, with country code — used for the WhatsApp/Call buttons
BRAND_PHONE=

# ---- Behaviour ----
# Browser test chat at /sim — set to "off" in production
SIMULATOR=on
# Seconds*1000 to wait after the last photo before moving to the next step
BATCH_IDLE_MS=8000
# DATA_DIR=./data
